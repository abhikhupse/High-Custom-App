# Redis used by BullMQ. Do not put real production credentials in this file.
REDIS_URL=redis://127.0.0.1:6379

# Maximum Gmail sends for one High Custom user in each window.
EMAILS_PER_USER_WINDOW=3
EMAIL_USER_WINDOW_MS=15000

# Number of BullMQ jobs one worker process may work on concurrently.
EMAIL_WORKER_CONCURRENCY=50

# Safety cap across the whole BullMQ queue.
EMAIL_GLOBAL_MAX_PER_SECOND=150
